               .floating_btn,
.floating_btn1 {
  position: fixed;
  bottom: 60px;
  width: 100px;
  height: 100px;
  display: flex;
  flex-direction: column;
  align-items:center;
  justify-content:center;
  z-index: 1000;

  /* NEW: don't show immediately */
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s ease;
}

.floating_btn { left: 30px; }
.floating_btn1 { right: 30px; }

/* When ready, fade in */
.floating_btn.show,
.floating_btn1.show {
  opacity: 1;
  pointer-events: auto;
}

        @keyframes pulsing {
          to {
            box-shadow: 0 0 0 30px rgba(232, 76, 61, 0);
          }
        }

        .contact_icon {
          background-color: #42db87;
          color: #fff;
          width: 60px;
          height: 60px;
          font-size:30px;
          border-radius: 50px;
          text-align: center;
          box-shadow: 2px 2px 3px #999;
          display: flex;
          align-items: center;
          justify-content: center;
          transform: translatey(0px);
          animation: pulse 1.5s infinite;
          box-shadow: 0 0 0 0 #42db87;
          -webkit-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          -moz-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          -ms-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          font-weight: normal;
          font-family: sans-serif;
          text-decoration: none !important;
          transition: all 300ms ease-in-out;
        }

        .contact_icon1 {
          background-color: #e21e49;
          color: #fff;
          width: 60px;
          height: 60px;
          font-size:30px;
          border-radius: 50px;
          text-align: center;
          box-shadow: 2px 2px 3px #999;
          display: flex;
          align-items: center;
          justify-content: center;
          transform: translatey(0px);
          transform: translatex(10px);
          animation: pulse 1.5s infinite;
          box-shadow: 0 0 0 0 #42db87;
          -webkit-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          -moz-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          -ms-animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          animation: pulsing 1.25s infinite cubic-bezier(0.66, 0, 0, 1);
          font-weight: normal;
          font-family: sans-serif;
          text-decoration: none !important;
          transition: all 300ms ease-in-out;
        }


        .text_icon {
          margin-top: 8px;
          color: #707070;
          font-size: 13px;
           background-color: white;
      padding: 5px;
      border-radius: 8px;
        }
         .text_icon1 {
          margin-top: 8px;
          color: #707070;
          font-size: 13px;
           background-color: white;
      padding: 5px;
      border-radius: 8px;
        }
