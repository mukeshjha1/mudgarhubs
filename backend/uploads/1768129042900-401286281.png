<script>
(function(){
  // Patterns to block
  var RX_SCRIPT = [/\/v2\/client\.init-shop/i, /\/v2\/chunk\.common/i, /shopify.*shop(-|\.|)runtime/i, /shopify.*shop(-|\.|)minis/i];
  var RX_FONT   = /GTStand(ar)?d/i;

  function blockedNode(n){
    if(!n || !n.tagName) return false;
    var tag = n.tagName.toLowerCase();
    if(tag === 'script'){
      var src = n.getAttribute('src') || '';
      return RX_SCRIPT.some(function(rx){ return rx.test(src); });
    }
    if(tag === 'link'){
      var rel = (n.getAttribute('rel')||'').toLowerCase();
      var as  = (n.getAttribute('as')||'').toLowerCase();
      var href= n.getAttribute('href')||'';
      // block GTStandard font loads (preload or css that points to it)
      if((rel==='preload' && as==='font' && RX_FONT.test(href)) || RX_FONT.test(href)) return true;
    }
    return false;
  }

  // Remove already present offenders (in case injected before we run)
  try{
    document.querySelectorAll('script[src],link[rel],link[href]').forEach(function(el){
      if(blockedNode(el)){ el.remove(); }
    });
  }catch(e){}

  // Monkey-patch creators and attachers BEFORE anything else runs
  var _createElement = Document.prototype.createElement;
  Document.prototype.createElement = function(name){
    var el = _createElement.call(this, name);
    try{
      var tag = (name||'').toString().toLowerCase();
      if(tag==='script' || tag==='link'){
        // Guard setAttribute on src/href
        var _setAttribute = el.setAttribute;
        el.setAttribute = function(attr, val){
          try{
            var a = (attr||'').toLowerCase();
            if((a==='src' || a==='href')){
              // temp set to inspect
              var tmpEl = el.cloneNode(false);
              _setAttribute.call(tmpEl, a, val);
              if(blockedNode(tmpEl)) return; // drop assignment
            }
          }catch(e){}
          return _setAttribute.call(this, attr, val);
        };
        // Guard property setters
        if(Object.defineProperty){
          try{
            Object.defineProperty(el, 'src', {
              set: function(v){ if(!v) return; var ok=true; RX_SCRIPT.forEach(function(rx){ if(rx.test(v)) ok=false; }); if(ok) el.setAttribute('src', v); },
              get: function(){ return el.getAttribute('src'); }
            });
          }catch(e){}
          try{
            Object.defineProperty(el, 'href', {
              set: function(v){ if(!v) return; if(!RX_FONT.test(v)) el.setAttribute('href', v); },
              get: function(){ return el.getAttribute('href'); }
            });
          }catch(e){}
        }
      }
    }catch(e){}
    return el;
  };

  function guardAttach(proto, method){
    var _fn = proto[method];
    proto[method] = function(node){
      try{ if(blockedNode(node)) return node; }catch(e){}
      return _fn.apply(this, arguments);
    };
  }
  guardAttach(Element.prototype, 'appendChild');
  guardAttach(Element.prototype, 'insertBefore');
  guardAttach(Element.prototype, 'replaceChild');

  // Ensure we never FOIT: force immediate fallback font
  try{
    var s = document.createElement('style');
    s.textContent = "html{font-display:swap!important} body,*{font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif!important}";
    document.head.appendChild(s);
  }catch(e){}
})();
</script><style>html{font-display:swap!important} body,*{font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif!important}</style>
 
    
