 <!--<script src="//shop.tagdaraho.in/cdn/shop/t/30/assets/tiny-img-link-preloader.js?13968" type="text/javascript"></script>-->
 <script>
(function () {
  function sortSelect(select) {
    const options = Array.from(select.options);
    options.sort((a, b) => {
      return Number(a.dataset.weight) - Number(b.dataset.weight);
    });
    options.forEach(o => select.appendChild(o));
  }

  async function loadProduct(handle) {
    const wrapper = document.getElementById('AjaxProductWrapper');
    if (!wrapper) return;

    const sectionId = wrapper.dataset.sectionId;
    if (!sectionId) return;

    const url = `/products/${handle}?section_id=${sectionId}`;

    wrapper.classList.add('is-loading');

    const res = await fetch(url, { credentials: 'same-origin' });
    const html = await res.text();

    const doc = new DOMParser().parseFromString(html, 'text/html');
    const incoming = doc.querySelector('#AjaxProductWrapper');
    if (!incoming) return;

    // Replace ONLY inner HTML (keeps wrapper + layout stable)
    wrapper.innerHTML = incoming.innerHTML;

    history.pushState({}, '', `/products/${handle}`);

    // Re-init Shopify section lifecycle
    document.dispatchEvent(new Event('shopify:section:load'));

    // Re-sort dropdown after replacement
    const newSelect = wrapper.querySelector('[data-ajax-product-select]');
    if (newSelect) sortSelect(newSelect);

    wrapper.classList.remove('is-loading');
  }

  document.addEventListener('change', function (e) {
    const select = e.target.closest('[data-ajax-product-select]');
    if (!select) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const handle = select.value;
    if (!handle) return;

    loadProduct(handle);
  }, true); // capture phase – REQUIRED

  document.addEventListener('DOMContentLoaded', () => {
    const select = document.querySelector('[data-ajax-product-select]');
    if (select) sortSelect(select);
  });
})();
</script>


