    <script>
(function(){
  function reveal(){
    document.querySelectorAll('.floating_btn,.floating_btn1')
      .forEach(e=>{e.style.opacity='1';e.style.pointerEvents='auto';});
  }
  ['click','scroll','mousemove','touchstart'].forEach(evt=>{
    window.addEventListener(evt,function once(){reveal();window.removeEventListener(evt,once);},{once:true,passive:true});
  });
  if('requestIdleCallback'in window)requestIdleCallback(reveal,{timeout:1500}); else setTimeout(reveal,1200);
